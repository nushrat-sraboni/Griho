# .editorconfig
#
# Tells every code editor the same basic habits (indent size, line endings),
# so files look the same no matter whose computer they were edited on.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
